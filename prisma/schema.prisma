generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
  MANAGER
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  RINGING // идёт дозвон
  IN_PROGRESS // разговор
  COMPLETED // завершён с разговором
  MISSED // входящий без ответа
  NO_ANSWER // исходящий без ответа
  BUSY
  FAILED
  CANCELED
}

enum CallOutcome {
  NEW
  INTERESTED
  CALLBACK
  REFUSED
  WRONG_NUMBER
  DEAL
  SPAM
  VOICEMAIL
  HUNG_UP // ответили и сразу сбросили
}

/// Итог звонка глазами менеджера — ставится во всплывающем окне после разговора.
enum CallResult {
  SUCCESS
  FAILURE
}

enum TaskStatus {
  ACTIVE
  COMPLETED
  CANCELED
}

/// Что считает прогресс задачи. Все метрики — по исходящим звонкам
/// исполнителя, уникальным номерам, внутри окна задачи.
enum TaskMetric {
  CALLS // завершённые исходящие с подтверждённым итогом, кроме автоответчика
  ANSWERED // подтверждённые разговоры с человеком
  SUCCESSFUL // звонки, отмеченные менеджером как успешные
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  phone              String?
  extension          String?   @unique // внутренний номер в АТС
  /// Личный внешний номер менеджера: входящий на него — звонок этого менеджера
  personalNumber     String?   @unique
  passwordHash       String?
  role               Role      @default(MANAGER)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  theme              String    @default("system")
  timezone           String    @default("Europe/Moscow")
  soundNotifications Boolean   @default(false)
  lastLoginAt        DateTime?
  createdById        String?
  createdBy          User?     @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers       User[]    @relation("UserCreator")
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  calls        Call[]
  invites      Invite[]
  auditLogs    AuditLog[]
  tasks        Task[]     @relation("TaskAssignee")
  createdTasks Task[]     @relation("TaskCreator")
  resultCalls  Call[]     @relation("CallResultBy")
  ownContacts  Contact[]  @relation("ContactOwner")

  @@index([role, isActive])
  @@index([deletedAt])
}

model Invite {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Contact {
  id        String   @id @default(cuid())
  phoneE164 String   @unique // единый формат +7XXXXXXXXXX
  name      String?
  company   String?
  note      String?
  isBlocked Boolean  @default(false)
  /// Ответственный менеджер: на него АТС направляет звонки с общего номера
  ownerId   String?
  owner     User?    @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calls Call[]

  @@index([name])
  @@index([ownerId])
}

model Call {
  id         String        @id @default(cuid())
  externalId String?       @unique // id звонка у провайдера, ключ идемпотентности
  provider   String        @default("mock")
  direction  CallDirection
  status     CallStatus
  outcome    CallOutcome   @default(NEW)

  fromNumber String
  toNumber   String
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id])

  userId String? // менеджер
  user   User?   @relation(fields: [userId], references: [id])

  startedAt       DateTime
  answeredAt      DateTime?
  endedAt         DateTime?
  waitSeconds     Int? // до ответа
  durationSeconds Int       @default(0) // длительность разговора
  billSeconds     Int?

  recordingUrl   String? // ссылка провайдера — источник для переноса в S3
  recordingReady Boolean @default(false) // есть что слушать: только у звонков с ответом
  recordingKey   String? // ключ файла в нашем S3; пусто — ещё не перенесли

  transcript CallTranscript?

  comment String?
  tags    String[] @default([])

  // Итог после звонка. resultRequired ставит бэкенд, когда звонок завершился
  // и менеджер должен его разметить — по этому флагу всплывает окно
  result         CallResult?
  summary        String?
  isImportant    Boolean     @default(false)
  resultRequired Boolean     @default(false)
  resultAt       DateTime?
  resultById     String?
  resultBy       User?       @relation("CallResultBy", fields: [resultById], references: [id])

  rawPayload Json? // сырой ответ провайдера, для отладки
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, startedAt])
  @@index([status, startedAt])
  @@index([startedAt])
  @@index([direction, startedAt])
  @@index([outcome, startedAt])
  @@index([contactId, startedAt])
  @@index([userId, resultRequired, result])
  @@index([isImportant, startedAt])
}

/// Задача менеджеру: «обзвонить 30 человек». Прогресс не хранится, а
/// считается по звонкам — счётчик не разъедется с журналом.
model Task {
  id          String     @id @default(cuid())
  /// Задачи, выданные одним действием нескольким менеджерам, — одна группа
  batchId     String
  title       String
  description String?
  metric      TaskMetric @default(CALLS)
  target      Int
  status      TaskStatus @default(ACTIVE)

  assigneeId  String
  assignee    User    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String?
  createdBy   User?   @relation("TaskCreator", fields: [createdById], references: [id])

  startsAt    DateTime  @default(now())
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([assigneeId, status])
  @@index([batchId])
  @@index([status, createdAt])
}

model CallTranscript {
  id        String   @id @default(cuid())
  callId    String   @unique
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING") // PENDING | PROCESSING | READY | FAILED
  language  String   @default("ru")
  fullText  String?
  segments  Json? // [{ speaker, startMs, endMs, text }]
  summary   String?
  provider  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String // user.create, user.deactivate, call.outcome.update, settings.update
  entityType String
  entityId   String?
  meta       Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action, createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Попытки входа — для rate limit 5/15 минут по связке IP + логин (ТЗ 3.4).
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  email     String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ip, email, createdAt])
  @@index([createdAt])
}
