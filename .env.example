# ─── База данных ────────────────────────────────────────────────────────────
# PostgreSQL на отдельном хосте. Спецсимволы в пароле обязательно URL-кодировать.
# connection_limit=10 — размер пула Prisma (см. ТЗ 8.1).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=prefer&connection_limit=10"

# ─── Аутентификация ─────────────────────────────────────────────────────────
NEXTAUTH_URL="https://vin2win.online"
# openssl rand -base64 32
AUTH_SECRET=""
# Доверять заголовкам X-Forwarded-* от nginx
AUTH_TRUST_HOST="true"

# 32 байта в base64 — шифрование чувствительных настроек в таблице Setting.
# openssl rand -base64 32
ENCRYPTION_KEY=""

# ─── Первый администратор (pnpm db:seed) ────────────────────────────────────
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Администратор"

# ─── Телефония ──────────────────────────────────────────────────────────────
# mock | sipuni | exolve
TELEPHONY_PROVIDER="mock"
EXOLVE_API_KEY=""
EXOLVE_API_URL="https://api.exolve.ru"
EXOLVE_WEBHOOK_SECRET=""
EXOLVE_NUMBER=""

# Sipuni (docs/SIPUNI_INTEGRATION.md)
SIPUNI_USER=""          # номер кабинета Sipuni
SIPUNI_SECRET=""        # ключ «Интеграция по API»
SIPUNI_WEBHOOK_TOKEN="" # openssl rand -hex 24 — дописывается к URL вебхука
SIPUNI_API_URL="https://sipuni.com/api"

# ─── Прочее ─────────────────────────────────────────────────────────────────
LOG_LEVEL="info"
TZ="Europe/Moscow"
NODE_ENV="production"
# Публичный адрес приложения — используется для сборки ссылок-приглашений
APP_URL="https://vin2win.online"

# BUILD_VERSION здесь задавать НЕ нужно: его вычисляет deploy.sh и зашивает
# в образ при сборке. Пустое значение в .env перетрёт зашитое через env_file,
# и /api/health начнёт врать, что развёрнута сборка «dev».
